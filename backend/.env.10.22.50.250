# 服务配置
SERVER_HOST=localhost
SERVER_PORT=8090
SERVER_MODE=release
CORS_ORIGIN=*

# 数据库配置
DB_HOST=localhost
DB_PORT=5432
DB_NAME=zonelease
DB_USER=postgres
DB_PASSWORD=Sunline11
DB_SSLMODE=disable

# 登录与会话配置
JWT_SECRET=zoneleasezoneleasezonelease
JWT_EXPIRE_HOURS=24
SESSION_IDLE_TIMEOUT_HOURS=12

# Redis 缓存与后台刷新
REDIS_ADDR=localhost:6379
REDIS_PASSWORD=Sunline11
REDIS_DB=0
RUNTIME_DNS_DEEP_SYNC_INTERVAL=1d
RUNTIME_DHCP_DEEP_SYNC_INTERVAL=1h
METRIC_RETENTION_DAYS=30
METRIC_STREAM_MAXLEN=10000
LOG_RETENTION_DAYS=30

# 前端 SSR 访问
ZONELEASE_SSR_API_ORIGIN=http://127.0.0.1:8090